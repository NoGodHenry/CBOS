#import "common/array"

class String extends ArrayView<byte> {
  new(data: &byte[], size: int) {
    this.data = data;
    this.size = size;
  }

  static func from(data: &byte[], len: int) -> String {
    return new String(data, len);
  }

  static func from_null_terminated(data: &byte[]) -> String {
    return new String(data, strlen_null_terminated(data));
  }

  static func strlen_null_terminated(data: &byte[]) -> int {
    len: int = 0;
    while (data[len] != 0) {
      len = len + 1;
    }

    return len;
  }
}