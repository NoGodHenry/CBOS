#import "common/array"
#import "common/string"

interface Logger {
  virtual func log(str: String) -> void;
  virtual func log(number: int) -> void;

  func log(str: &byte[], len: int) -> void {
    this.log(String.from(str, len));
  }

  func log_null_terminated(str: &byte[]) -> void {
    this.log(String.from_null_terminated(str));
  }
}