#import "memory/pmm/common/pmm"
#import "common/optional"
#import "main"

class BumpPhysicalMemoryManager impl PhysicalMemoryManager, Loadable {
  base: long;
  length: long;
  index: long;

  new() {
    base = 0;
    length = 0;
  }

  mut virtual func load() -> void {
    table: &mut MemoryMapTable = System.loader.get_memory_map();
    usableMemory: Optional<&MemoryMapEntry> = table.get_usable_memory();
    if (!usableMemory.is_present()) {
      System.panic("No usable memory found!");
      return;
    }

    this.base = usableMemory.get_value_unsafe().base;
    this.length = usableMemory.get_value_unsafe().length;
    this.index = base;
  }

  func pointer_alloc(size: long, alightment: int) -> long {
    if (index + size >= length) {
      System.panic("Out of memory!");
    }

    index = (index + size + (alightment - 1)) & ~(alightment - 1);

    return index;
  }

  virtual func alloc_aligned(size: long, alightment: int) -> &mut AllocationBlock {
    return pointer_alloc(size, alightment) as &mut AllocationBlock;
  }
}