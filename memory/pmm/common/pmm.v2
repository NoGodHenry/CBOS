#import "memory/paging/common/page_table"
#import "memory/pmm/common/allocation_block"

interface PhysicalMemoryManager {
  func alloc_page_aligned() -> &mut PageTable {
    return (this.alloc_aligned(8, 4096)) as &mut PageTable;
  }

  // size in bytes
  virtual func alloc_aligned(size: long, alightment: int) -> &mut AllocationBlock {
}