#import "memory/paging/common/page_entry"

class PageTable {
  entries: PageEntry[256];

  new() {
    i: int = 0;
    while (i < 256) {
      entries[i].flags = 0;
      i = i + 1;
    }
  }

  func present(index: int) -> bool {
    return this.entries[index].present();
  }

  func get_page_entry(index: int) -> &mut PageEntry {
    return &mut this.entries[index];
  }
}

