#import "memory/paging/common/page_table"
#import "memory/paging/common/page_entry"
#import "common/loadable"

class Paging impl Loadable {
  pml4_table: PageTable;
  index: int;

  new() {
    pml4_table = new PageTable();
  }

  mut virtual func load() -> void {

  }

  mut func map_page(physical_address: long, virtual_address: long) -> void {
    map_page_no_flush(physical_address, virtual_address);

    flush_paging(virtual_address);
  }

  mut func map_page_no_flush(physical_address: long, virtual_address: long) -> void {
    pml4_index: int = (virtual_address >> 39) & 0x1FF as int;
    pdp_index: int = (virtual_address >> 30) & 0x1FF as int;
    pd_index: int = (virtual_address >> 21) & 0x1FF as int;
    pt_index: int = (virtual_address >> 12) & 0x1FF as int;

    pdp_table: &mut PageTable = get_page_table(&mut pml4_table, pml4_index);
    pd_table: &mut PageTable = get_page_table(pdp_table, pdp_index);
    pt_table: &mut PageTable = get_page_table(pd_table, pd_index);
  }

  static func get_page_table(table: &mut PageTable, index: int) -> &mut PageTable {
    if (!table.present(index)) {
      entry: &mut PageTable table = table.get_page_entry(index)
      base_table: &mut PageTable = System.pmm.alloc_page_aligned();

      entry.present(true);

      entry.physical_address(
          (base_table as long) >> 12
      );

      return base_table;
    }

    return (table.get_page_entry(index).physical_address() << 12) as &mut PageTable;
  }

  static native func set_page_address(pointer: &PageTable) -> void;

  static native func flush_paging(virtual_address: long) -> void;
}
