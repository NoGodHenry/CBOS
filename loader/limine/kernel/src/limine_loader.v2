#import "loader/common/loader"
#import "loader/common/framebuffer"
#import "loader/common/memmap_table"
#import "loader/common/memmap_entry"
#import "loader/limine/kernel/src/limine_framebuffer"
#import "main"

class LimineLoader impl Loader {
  framebuffer: LimineFramebuffer;
  memory_map: MemoryMapTable;

  mut virtual func load() -> void {

  }
  
  static func static_load() -> void {
    System.init();
  }

  static func set_static_framebuffer(array: &mut int[], width: int, height: int) -> void {
    System.loader.set_framebuffer(array, width, height);
  }

  static func set_static_memory_map(entries: &MemoryMapEntry&[], entries_size: int) -> void {
    System.loader.set_memory_map(entries, entries_size);
  }

  static func post_init() -> void {
    System.post_init();
  }

  mut func set_framebuffer(array: &mut int[], width: int, height: int) -> void {
    this.framebuffer = new LimineFramebuffer(array, width, height);
  }

  mut func set_memory_map(entries: &MemoryMapEntry&[], entries_size: int) -> void {
    this.memory_map = new MemoryMapTable(new ArrayView<&MemoryMapEntry>(entries_size, entries));
  }

  virtual mut func get_framebuffer() -> &mut LoaderFramebuffer {
    return &mut this.framebuffer;
  }
}
