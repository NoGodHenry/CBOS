#import "loader/common/framebuffer"

class LimineFramebuffer impl LoaderFramebuffer {
  array: &mut int[];
  width: int;
  height: int;

  new(array_: &mut int[], width_: int, height_: int) {
    this.array = array_;
    this.width = width_;
    this.height = height_;
  }

  mut virtual func write(x: int, y: int, value: int) -> void {
    if (x < 0 || x > width)
      return;

    if (y < 0 || y > height)
      return;

    this.array[x + this.width * y] = value;
  }

  mut virtual func get_height() -> int {
    return this.height;
  }

  virtual func get_width() -> int {
    return this.width;
  }
}
