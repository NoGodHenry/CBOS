#import "graphics/common/graphics"
#import "graphics/common/canvas"
#import "graphics/term/terminal"

class TerminalGraphics impl Graphics {
  terminal: Terminal;
  canvas: Canvas;

  mut virtual func load() -> void {
    framebuffer: &mut LoaderFramebuffer = System.loader.get_framebuffer();

    this.canvas = new Canvas(&mut System.font, framebuffer);
    this.terminal = new Terminal(framebuffer.get_height() / System.font.character_height(), &mut this.canvas);
  }

  mut virtual func get_terminal() -> &mut TerminalLike {
    return &mut this.terminal;
  }
}
