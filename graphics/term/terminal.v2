#import "common/drawable"
#import "common/string"
#import "common/text_canvas"

class Terminal {
  line_count: int;
  canvas: &mut TextCanvas;

  line_index: int;
  line_offset: int;

  new(line_count: int, canvas: &mut TextCanvas) {
    this.line_count = line_count;
    this.canvas = canvas;

    this.line_index = 0;
    this.line_offset = 0;
  }

  mut virtual func append(str: String) -> void {
    canvas.draw_text(this.line_offset, this.line_index, str);

    this.line_offset = this.line_offset + str.size;
  }

  mut virtual func new_line() -> void {
    this.line_offset = 0;
    this.line_index = this.line_index + 1;

    if (this.line_index >= this.line_count) {
      this.line_index = 0;
    }
  }
}